{
    "swagger": "2.0",
    "info": {
        "description": "This is E-Commerce API server",
        "title": "E-Commerce API",
        "termsOfService": "http://github.com/ZUBERKHAN034/go-ecom",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/product": {
            "post": {
                "description": "Create Product",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Product"
                ],
                "summary": "Create Product",
                "parameters": [
                    {
                        "description": "Product Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.CreateProductPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product created successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Product already exists",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/products": {
            "get": {
                "description": "Get Products",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Product"
                ],
                "summary": "Get Products",
                "responses": {
                    "200": {
                        "description": "List of products",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.ProductSchema"
                            }
                        }
                    }
                }
            }
        },
        "/user/login": {
            "post": {
                "description": "Login",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "User"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "User Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.LoginUserPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User logged in successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Invalid password",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "description": "Register",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "User"
                ],
                "summary": "Register",
                "parameters": [
                    {
                        "description": "User Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.RegisterUserPayload"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User Registered successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "User already exists",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.CreateProductPayload": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "image": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "controllers.LoginUserPayload": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "controllers.RegisterUserPayload": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "models.ProductSchema": {
            "description": "Product details",
            "type": "object",
            "properties": {
                "createdAt": {
                    "description": "CreatedAt represents the timestamp when the product was added\n@json createdAt\n@example \"2024-03-19T12:00:00Z\"",
                    "type": "string",
                    "example": "2024-03-19T12:00:00Z"
                },
                "description": {
                    "description": "Description provides details about the product\n@json description\n@example \"High-quality wireless headphones with noise cancellation.\"",
                    "type": "string",
                    "example": "High-quality wireless headphones with noise cancellation."
                },
                "id": {
                    "description": "ID is the unique identifier for the product\n@json id\n@example 1",
                    "type": "integer",
                    "example": 1
                },
                "image": {
                    "description": "Image is the URL to the product image\n@json image\n@example \"https://example.com/images/headphones.jpg\"",
                    "type": "string",
                    "example": "https://example.com/images/headphones.jpg"
                },
                "name": {
                    "description": "Name of the product\n@json name\n@example \"Wireless Headphones\"",
                    "type": "string",
                    "example": "Wireless Headphones"
                },
                "price": {
                    "description": "Price of the product\n@json price\n@example 99.99",
                    "type": "number",
                    "example": 99.99
                },
                "quantity": {
                    "description": "Quantity available in stock\n@json quantity\n@example 50",
                    "type": "integer",
                    "example": 50
                },
                "updatedAt": {
                    "description": "UpdatedAt represents the last updated timestamp of the product\n@json updatedAt\n@example \"2024-03-19T12:30:00Z\"",
                    "type": "string",
                    "example": "2024-03-19T12:30:00Z"
                }
            }
        }
    }
}